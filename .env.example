# Copie para .env.local (ignorado). Valores vazios são placeholders, não credenciais.
# Públicos; obrigatórios apenas ao utilizar os clientes Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreto; obrigatório apenas para operações privilegiadas no servidor.
SUPABASE_SECRET_KEY=
# Secreto; reservado para ferramentas de banco, não usado pelo runtime HTTP.
DATABASE_URL=
# Origem exata da aplicação (ex.: http://localhost:3000), sem caminho.
NEXT_PUBLIC_SITE_URL=
# Segredo aleatório de no mínimo 32 caracteres para HMAC do rate limiting.
AUTH_RATE_LIMIT_SECRET=
